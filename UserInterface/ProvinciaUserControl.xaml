<UserControl x:Class="UserInterface.ProvinciaUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="800" Height="92">
    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="#FFFFFF" Margin="2" Padding="6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column headers / Labels -->
            <Label Grid.Row="0" Grid.Column="0" Content="ID" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" Padding="2,0"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Nombre" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" Padding="2,0"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Población" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" Padding="2,0"/>
            <Label Grid.Row="0" Grid.Column="3" Content="Superficie (km²)" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" Padding="2,0"/>
            <Label Grid.Row="0" Grid.Column="4" Content="Escudo" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" Padding="2,0"/>
            <Label Grid.Row="0" Grid.Column="5" Content="Mapa" FontWeight="SemiBold" FontSize="11" Foreground="#4B5563" HorizontalAlignment="Center" Padding="2,0"/>

            <!-- Inputs -->
            <TextBox x:Name="idTextBox" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="26" Margin="2,0"
                     Padding="4,2" LostFocus="idTextBox_LostFocus" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="nombreTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="26" Margin="2,0"
                     Padding="4,2" LostFocus="nombreTextBox_LostFocus"/>
            <TextBox x:Name="poblacionTextBox" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Height="26" Margin="2,0"
                     Padding="4,2" ToolTip="Población (número entero >= 0)" LostFocus="poblacionTextBox_LostFocus"/>
            <TextBox x:Name="superficieTextBox" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Height="26" Margin="2,0"
                     Padding="4,2" ToolTip="Superficie en km² (ej. 1234,56)" LostFocus="superficieTextBox_LostFocus"/>

            <!-- Escudo container -->
            <Grid Grid.Row="1" Grid.Column="4" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="escudoPlaceholder" Text="Sin foto" FontSize="9" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Image x:Name="escudoImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Button x:Name="selectEscudoButton" Content="Elegir" FontSize="10" Height="19" Padding="2,0" Margin="0,1" Click="selectEscudoButton_Click" ToolTip="Seleccionar escudo"/>
                    <Button x:Name="clearEscudoButton" Content="Quitar" FontSize="10" Height="19" Padding="2,0" Margin="0,1" Click="clearEscudoButton_Click" ToolTip="Quitar escudo"/>
                </StackPanel>
            </Grid>

            <!-- Mapa container -->
            <Grid Grid.Row="1" Grid.Column="5" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="mapaPlaceholder" Text="Sin foto" FontSize="9" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Image x:Name="mapaImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Button x:Name="selectMapaButton" Content="Elegir" FontSize="10" Height="19" Padding="2,0" Margin="0,1" Click="selectMapaButton_Click" ToolTip="Seleccionar mapa"/>
                    <Button x:Name="clearMapaButton" Content="Quitar" FontSize="10" Height="19" Padding="2,0" Margin="0,1" Click="clearMapaButton_Click" ToolTip="Quitar mapa"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
